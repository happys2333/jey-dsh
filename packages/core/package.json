{
  "name": "jey-core",
  "version": "0.0.0",
  "private": true,
  "description": "Jey decision core: boundary validation, pure policy, egress policy. No DSH, no network, no fs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:property": "node --test \"test/property/*.test.ts\""
  },
  "dependencies": {
    "jey-contracts": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.2.0"
  }
}
