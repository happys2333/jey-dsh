{
  "name": "jey-provider-typesafe",
  "version": "0.0.0",
  "private": true,
  "description": "Jey provider for the official TypeSafe / Jev systemone API, validated against fixtures rather than casts.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test \"test/contract/*.test.ts\"",
    "test:property": "echo \"no property tests in this package\" && exit 0"
  },
  "dependencies": {
    "jey-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
